{
  "name": "proyecto",
  "version": "1.0.0",
  "description": "proyecto bienes raices",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "server": "nodemon index.js",
    "build:css": "postcss public/css/tailwind.css -o public/css/output.css",
    "watch:css": "postcss public/css/tailwind.css -o public/css/output.css --watch",
    "dev": "concurrently \"npm run server\" \"npm run watch:css\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "MVC",
    "Tailwind",
    "MySQL",
    "Sequelize",
    "Pug"
  ],
  "author": "Luis Fernando Sierra Cantor",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "^5.2.1",
    "pug": "^3.0.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.14",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.3.0"
  }
}
